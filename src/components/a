import { useEffect, useState } from 'react';
import { Check, X, Minus } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { type Player } from '@/lib/football';
import { attendanceValue, attendanceWindow, recentSaturdays, recordAttendance, shortDate } from '@/lib/attendance';
import { cn } from '@/lib/utils';

function useSaturdays(){const [today,setToday]=useState('');useEffect(()=>{const update=()=>setToday(new Intl.DateTimeFormat('en-CA',{timeZone:'America/Maceio',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));update();const timer=setInterval(update,60000);return()=>clearInterval(timer);},[]);return {today,dates:today?recentSaturdays(today):[]};}
export function AttendanceDisplay({player}:{player:Player}) {
 const {dates}=useSaturdays();
 if(player.membership==='ouro')return <div className="attendance-display gold-attendance" aria-label="Sócio Ouro"><div className="attendance-top"><div className="attendance-segments">{Array.from({length:5},(_,i)=><span key={i} className="filled"/>)}</div><strong>OURO</strong></div><div className="gold-attendance-note">🥇 Sócio Ouro · vaga garantida</div></div>;
 const window=attendanceWindow(player.attendanceBase??player.attendance,player.attendanceRecords??[]);
 return <div className="attendance-display"><div className="attendance-top"><div className="attendance-segments" role="meter" aria-label="Frequência" aria-valuenow={player.attendance} aria-valuemin={0} aria-valuemax={100}>{Array.from({length:5},(_,i)=><span key={i} className={cn(window[i]&&'filled')}/>)}</div><strong>{player.attendance}%</strong></div><div className="attendance-dates">{Array.from({length:5},(_,i)=>{const date=dates[i];const status=player.attendanceRecords?.find(record=>record.date===date)?.status;const label=status==='present'?'Presença':status==='absent'?'Falta':'Sem registro';return <span key={date??i} className={cn('attendance-day',status)} title={`${date??'—'} · ${label}`} aria-label={`${date?shortDate(date):'—'}: ${label}`}><small>{date?shortDate(date):'—'}</small>{status==='present'?<Check size={11}/>:status==='absent'?<X size={11}/>:<Minus size={11}/>}</span>;})}</div></div>;
}
export function AttendanceEditor({player,onChange}:{player:Player;onChange:(player:Player)=>void}) {
 const {dates}=useSaturdays();
 if(player.membership==='ouro')return <section className="attendance-editor col-span-2"><div className="gold-member-badge">🥇 SÓCIO OURO</div><p className="attendance-rule">Sócio Ouro não precisa marcar frequência.</p></section>;
 return <section className="attendance-editor col-span-2"><div className="attendance-editor-heading"><h3>Presença em campo</h3><strong>{player.attendance}%</strong></div><label>Frequência inicial (%)<Input type="number" min={0} max={100} required value={player.attendanceBase??player.attendance} onChange={e=>{const base=Number(e.target.value);onChange({...player,attendanceBase:base,attendance:attendanceValue(base,player.attendanceRecords??[])});}}/></label><AttendanceDisplay player={player}/><div className="attendance-checklist" role="group" aria-label="Sábados">{dates.map(d=>{const present=player.attendanceRecords?.find(r=>r.date===d)?.status==='present';return <label key={d} className={cn('attendance-check',present&&'checked')}><input type="checkbox" checked={present} onChange={e=>onChange(recordAttendance(player,d,e.target.checked?'present':'absent'))}/><span>{shortDate(d)}</span></label>;})}</div><p className="attendance-rule">Cada sábado vale 20% · Conta só os últimos 5 sábados</p></section>;
}
